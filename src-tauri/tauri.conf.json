{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FontBridge",
  "version": "0.1.0",
  "identifier": "io.github.mdfox-chaoszone.fontbridge",
  "mainBinaryName": "fontbridge",
  "build": {
    "beforeDevCommand": "trunk serve --config frontend/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --config frontend/Trunk.toml --release",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FontBridge",
        "width": 1040,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Convert TTF and OTF fonts to and from WOFF2",
    "longDescription": "A cross-platform graphical interface for the Google WOFF2 encoder and decoder.",
    "copyright": "Copyright © 2026 FontBridge contributors",
    "windows": {
      "signCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 %1"
    }
  }
}
