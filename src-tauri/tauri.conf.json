{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Font Converter",
  "version": "1.0.0",
  "identifier": "io.github.mdfox-chaoszone.fontconverter",
  "mainBinaryName": "font-converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Font Converter",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Convert fonts between TTF, OTF, and WOFF2",
    "longDescription": "A cross-platform graphical interface for the Google WOFF2 encoder and decoder.",
    "copyright": "Copyright © 2026 Font Converter contributors",
    "windows": {
      "signCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 %1"
    }
  }
}
