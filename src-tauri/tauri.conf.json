{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ttf2woff2-GUI",
  "version": "0.1.0",
  "identifier": "io.github.ttf2woff2gui",
  "mainBinaryName": "ttf2woff2-gui",
  "build": {
    "beforeDevCommand": "trunk serve --config frontend/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --config frontend/Trunk.toml --release",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ttf2woff2-GUI",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Convert TrueType fonts to WOFF2",
    "longDescription": "A cross-platform graphical interface for the pure Rust ttf2woff2 encoder.",
    "copyright": "Copyright © 2026 ttf2woff2-GUI contributors",
    "windows": {
      "signCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 %1"
    }
  }
}
